# Modèle du Secret Kubernetes « eduvox-secrets ». NE JAMAIS mettre de vraies valeurs dans Git.
# 1. Copier ce fichier en secrets.env (ignoré par Git) et le remplir
# 2. kubectl -n eduvox create secret generic eduvox-secrets --from-env-file=secrets.env
# Générer SECRET_KEY : python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
GEMINI_API_KEY=
GEMINI_MODEL=
HF_TOKEN=